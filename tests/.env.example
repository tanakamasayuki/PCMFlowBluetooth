# Serial ports per sketch.yaml profile.
# Profile names are uppercased by pytest-embedded
# (e.g. profile `esp32` -> TEST_SERIAL_PORT_ESP32).
# The default `host` profile uses a socket and does not need a serial port.
TEST_SERIAL_PORT_ESP32=/dev/ttyUSB0

# Original-ESP32 pair for the two-board tests under peer/. The DUT plays the
# A2DP Sink, the peer plays the A2DP Source. `host` / `device` name the parent
# side and the second peer on pytest-embedded-cli; they do not describe A2DP
# roles. These port names are shared with the EspBle and EspBleBluedroid
# repositories, so the same physical pair can be used from any of them —
# the serial ports are held exclusively, so concurrent runs just wait.
TEST_SERIAL_PORT_ESP32_PEER_HOST=/dev/ttyUSB0
TEST_SERIAL_PORT_PEER_DEVICE_ESP32_PEER_DEVICE=/dev/ttyUSB1

# Optional: generate an HTML report
#PYTEST_ADDOPTS="--html=report.html --self-contained-html"
